{
  "name": "dcsolutions-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "dcsolutions.app", "custom_domain": true },
    { "pattern": "www.dcsolutions.app", "custom_domain": true }
  ],
  "vars": { "VITRINE_V2": "1", "VITRINE_V3": "0" },
  "observability": { "enabled": true }
}
